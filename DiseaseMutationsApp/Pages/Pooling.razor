@page "/pooling"
@using DiseaseMutationsApp.Services

<PageTitle>Guide Pooling</PageTitle>

<div class="container-max-xl">
    <header class="page-header">
        <h1 class="page-title" tabindex="-1">Guide Pooling</h1>
        <div class="page-rail" aria-hidden="true"></div>
        <p class="page-lede">Combine guides into wells so a whole variant panel can be screened in far fewer reactions.</p>
    </header>

    <div class="row mb-5">
        <div class="col-lg-10 col-xl-8">
            <div class="card">
                <div class="card-body">
                    <h2 class="card-title section-title mb-4">
                        <Icon Name="settings" />Input Parameters
                    </h2>

                    <TabStrip TItem="PoolingInputMode" Items="InputModes" KeyOf="m => m.ToString()" ActiveKey="@_inputMode.ToString()"
                              ActiveKeyChanged="k => SetInputMode(Enum.Parse<PoolingInputMode>(k))" IdPrefix="pool-input" AriaLabel="Guide input mode" Small="true">
                        <ItemTemplate Context="mode">
                            <Icon Name="@(mode == PoolingInputMode.GuideCount ? "chart" : "list")" />@(mode == PoolingInputMode.GuideCount ? "Guide count" : "Guide list")
                        </ItemTemplate>
                    </TabStrip>

                    <div class="tab-panel mb-3" role="tabpanel" id="@InputPanelId" aria-labelledby="@InputTabId">
                        @if (_inputMode == PoolingInputMode.GuideCount)
                        {
                            <div class="mb-2">
                                <label for="guide-count" class="form-label">Number of guides (V)</label>
                                <input id="guide-count" type="number" class="form-control input-max-sm"
                                       @bind="_guideCount" min="1" max="@PoolingService.MaxGuideCount" />
                                <small class="text-muted mt-2 d-block">
                                    One guide per pathogenic variant you intend to screen.
                                </small>
                            </div>
                        }
                        else
                        {
                            <div class="mb-2">
                                <label for="guide-list" class="form-label">Guides</label>
                                <textarea id="guide-list" class="form-control" rows="6" @bind="_guideListText"
                                          placeholder="One guide per line (or comma-separated) — or paste a CSV report downloaded from the Diana tab"></textarea>

                                @if (_parsedGuides.Count > 0)
                                {
                                    <div class="alert alert-info mt-3 mb-0">
                                        <div class="alert-heading mb-2">
                                            <Icon Name="check" />
                                            Detected @(_guideListSource == GuideListSource.BuilderCsv ? "a Diana CSV report" : "a plain guide list")
                                            — <strong>@_parsedGuides.Count</strong> guide@(_parsedGuides.Count == 1 ? "" : "s").
                                        </div>
                                        <div class="alert-detail">
                                            @string.Join(", ", _parsedGuides.Take(8).Select(g => g.Label))@(_parsedGuides.Count > 8 ? $", … (+{_parsedGuides.Count - 8} more)" : "")
                                        </div>
                                        @foreach (var warning in _parseWarnings)
                                        {
                                            <div class="alert-detail mt-1"><Icon Name="info" />@warning</div>
                                        }
                                    </div>
                                }
                                else if (!string.IsNullOrWhiteSpace(_guideListText))
                                {
                                    <div class="alert alert-warning mt-3 mb-0">
                                        No guides could be read from that text.
                                    </div>
                                }
                                else
                                {
                                    <small class="text-muted mt-2 d-block">
                                        A Builder report keeps the best-ranked mutated spacer for each variant.
                                    </small>
                                }
                            </div>
                        }
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-sm-5">
                            <label for="well-capacity" class="form-label">Guides per well (K)</label>
                            <input id="well-capacity" type="number" class="form-control" @bind="_wellCapacity" min="1" />
                            <small class="text-muted mt-2 d-block">
                                Guides are transcribed in tandem; more than 5–6 risks RNA conformations that block Cas13.
                            </small>
                        </div>
                        <div class="col-sm-5">
                            <label for="plate-format" class="form-label">Plate format</label>
                            <select id="plate-format" class="form-select" @bind="_plate" @bind:after="OnPlateChanged">
                                <option value="@PlateKind.Plate96">96-well (8 × 12)</option>
                                <option value="@PlateKind.Plate384">384-well (16 × 24)</option>
                            </select>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-2">
                        <button class="btn btn-primary btn-lg" @onclick="Calculate" disabled="@(!CanCalculate)">
                            <Icon Name="grid" />
                            <span>Calculate distribution</span>
                        </button>
                        @if (_plan is not null)
                        {
                            <button class="btn btn-outline-secondary btn-lg" @onclick="ClearAll">
                                <Icon Name="trash" />
                                <span>Reset</span>
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (_errorMessage is not null)
    {
        <div class="row mb-5">
            <div class="col-lg-10 col-xl-8">
                <div class="alert alert-danger">
                    <div class="alert-heading"><Icon Name="alert" />Cannot build a plan</div>
                    <div class="alert-detail">@_errorMessage</div>
                </div>
            </div>
        </div>
    }

    @if (_estimates is not null && _plan is not null)
    {
        <div class="row mb-5 fade-in">
            <div class="col">
                <div class="card">
                    <div class="card-body">
                        <h2 class="card-title section-title mb-4">
                            <Icon Name="chart" />Model comparison
                        </h2>
                        <PoolingModelComparison Estimates="_estimates"
                                                ActiveModel="_plan.Model"
                                                IsOverridden="@(!_estimates[0].Model.Equals(_plan.Model))"
                                                OnSelect="SelectModel"
                                                OnUseOptimal="UseOptimalModel" />
                    </div>
                </div>
            </div>
        </div>

        <div class="row mb-5 fade-in">
            <div class="col">
                <div class="card">
                    <div class="card-body">
                        <h2 class="card-title section-title mb-4">
                            <Icon Name="table" />@_plan.ModelName distribution
                        </h2>

                        <div class="row g-3 mb-4">
                            <div class="col-6 col-md-3 col-lg-2">
                                <div class="pool-stat">
                                    <div class="pool-stat-value metric-variant">@_plan.GuideCount</div>
                                    <div class="pool-stat-label">Guides (V)</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3 col-lg-2">
                                <div class="pool-stat">
                                    <div class="pool-stat-value metric-reference">@_plan.NonEmptyWells</div>
                                    <div class="pool-stat-label">Mixes to prepare</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3 col-lg-2">
                                <div class="pool-stat">
                                    <div class="pool-stat-value metric-plain">@_plan.TotalWells</div>
                                    <div class="pool-stat-label">Wells reserved (N)</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3 col-lg-2">
                                <div class="pool-stat">
                                    <div class="pool-stat-value metric-plain">@_plan.Repetitions</div>
                                    <div class="pool-stat-label">Repetitions (R)</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3 col-lg-2">
                                <div class="pool-stat">
                                    <div class="pool-stat-value metric-plain">@_plan.MaxPoolSize</div>
                                    <div class="pool-stat-label">Largest mix</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3 col-lg-2">
                                <div class="pool-stat">
                                    <div class="pool-stat-value metric-reference">@_plan.PlateCount</div>
                                    <div class="pool-stat-label">Plate@(_plan.PlateCount == 1 ? "" : "s")</div>
                                </div>
                            </div>
                        </div>

                        <p class="helper-note text-muted">
                            <Icon Name="info" />
                            Screening @_plan.GuideCount guides individually would take @_plan.GuideCount reactions;
                            this layout needs @_plan.NonEmptyWells, and each guide appears in @_plan.Repetitions of them.
                        </p>

                        <h3 class="h6 mt-4 mb-3">Plate map</h3>
                        <PoolPlateMap Plan="_plan"
                                      ActivePlate="_activePlate"
                                      SelectedPoolId="_selectedPoolId"
                                      OnSelectPool="SelectPool"
                                      OnShowPlate="ShowPlate" />

                        @if (SelectedPool is { } selected)
                        {
                            <div class="card mt-4 pool-detail-card">
                                <div class="card-body">
                                    <h6 class="card-title mb-3">
                                        Tube @selected.Id &mdash; @selected.Name
                                        <span class="text-muted ms-2">@selected.WellLabel</span>
                                    </h6>
                                    @if (selected.IsEmpty)
                                    {
                                        <p class="mb-0 pool-empty-note">This slot is reserved by the layout but holds no guides &mdash; do not prepare it.</p>
                                    }
                                    else
                                    {
                                        <div class="sequence-block p-3 rounded">
                                            @string.Join(", ", selected.GuideLabels)
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <div class="d-flex align-items-center justify-content-between mt-5 mb-3">
                            <h3 class="h6 mb-0">Mixture list</h3>
                            <button class="btn btn-outline-secondary" @onclick="DownloadPlan">
                                <Icon Name="download" />
                                <span>Download CSV</span>
                            </button>
                        </div>
                        <PoolTable Pools="_plan.Pools"
                                   SelectedPoolId="_selectedPoolId"
                                   OnSelectPool="SelectPool" />

                        <h3 class="h6 mt-5 mb-3">Decode screening results</h3>
                        <p class="text-muted">
                            Enter the wells that read positive (for example <code>A1, B3, Plate 2 - C4</code>, or tube numbers
                            like <code>#12</code>) to find which guides they implicate.
                        </p>
                        <label for="decode-wells" class="form-label">Positive wells</label>
                        <textarea id="decode-wells" class="form-control" rows="3" @bind="_decodeText" @bind:event="oninput"></textarea>
                        <div class="mt-2">
                            <button class="btn btn-outline-primary" @onclick="RunDecode">Decode</button>
                        </div>
                        @if (_decodeResult is { } d)
                        {
                            <div class="mt-3" role="status">
                                @if (d.Unrecognised.Count > 0)
                                {
                                    <div class="alert alert-warning">Not recognised: @string.Join(", ", d.Unrecognised)</div>
                                }
                                @if (d.Implicated.Count == 0)
                                {
                                    <div class="alert alert-info">No guide has all of its wells positive.</div>
                                }
                                else
                                {
                                    <div class="alert @(d.IsAmbiguous ? "alert-warning" : "alert-success")">
                                        <strong>@d.Implicated.Count</strong> guide@(d.Implicated.Count == 1 ? "" : "s") consistent with the readout.
                                        @if (d.IsAmbiguous)
                                        {
                                            <span> Some may be false positives from overlapping hits &mdash; confirm individually.</span>
                                        }
                                    </div>
                                    <ul class="mb-3">
                                        @foreach (var g in d.Definite)
                                        {
                                            <li><strong>@g.Label</strong> &mdash; definite (wells @string.Join(", ", g.Wells))</li>
                                        }
                                        @foreach (var g in d.Ambiguous)
                                        {
                                            <li>@g.Label &mdash; ambiguous (wells @string.Join(", ", g.Wells))</li>
                                        }
                                    </ul>
                                }
                                @if (d.PartiallySupported.Count > 0)
                                {
                                    <p class="text-muted mb-1">Partially supported (some, not all, wells positive):
                                        @string.Join(", ", d.PartiallySupported.Select(g => g.Label))</p>
                                }
                                @if (d.UnexplainedPools.Count > 0)
                                {
                                    <p class="text-muted mb-0">Positive wells no guide fully explains: @string.Join(", ", d.UnexplainedPools)</p>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    // Logic moved to Pooling.razor.cs
}
