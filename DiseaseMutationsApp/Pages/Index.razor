@page "/"
@using DiseaseMutationsApp.Services
@using DiseaseMutationsApp.Pages
@using BlazorBootstrap

<PageTitle>gRNA Builder</PageTitle>

<div class="container-fluid px-4 py-4 fade-in-up" style="max-width: 1500px;">
    <div class="row mb-5">
        <div class="col">
            <h1 class="mb-2" style="background: linear-gradient(135deg, #06B6D4 0%, #A855F7 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
                🧬 gRNA Builder
            </h1>
            <p class="text-muted mb-0">Design and analyze guide RNA sequences for CRISPR applications</p>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-lg-9 col-xl-7">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-4" style="color: var(--color-teal-light);">
                        <span class="oi oi-cog me-2"></span>Input Parameters
                    </h5>
                    <div class="mb-4">
                        <label for="hgvs" class="form-label">HGVS or RS codes (comma-separated for multiple)</label>
                        <textarea id="hgvs" class="form-control" @bind="_hgvs" rows="5" placeholder="e.g., NG_016465.4:g.98765C>T, rs12345, NG_056131.3:g.755G>A&#10;You can enter multiple HGVS or RS codes separated by commas"></textarea>
                        <small class="text-muted mt-2 d-block">Enter one or more genetic variants to analyze</small>
                    </div>
                    <div class="mb-4">
                        <label for="before" class="form-label">gRNA size</label>
                        <input id="before" type="number" class="form-control" @bind="_gRnaSize" min="1" style="max-width: 220px;"/>
                    </div>
                    <button class="btn btn-primary btn-lg mt-2" @onclick="FetchData">
                        <span class="oi oi-data-transfer-download me-2"></span>
                        <span>Fetch Data</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (_inputTabs.Any())
    {
        <div class="row mb-5 fade-in-up">
            <div class="col">
                <ul class="nav nav-tabs" role="tablist">
                    @for (var i = 0; i < _inputTabs.Count; i++)
                    {
                        var tab = _inputTabs[i];
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(i == _activeTabIndex ? "active" : "")" 
                                    type="button" 
                                    @onclick="() => _activeTabIndex = i">
                                @{
                                    var isLoading = tab.IsLoading || tab is { Type: InputType.HGVS, DirectHgvs.IsLoading: true };
                                    var hasError = tab.ErrorMessage != null || tab is { Type: InputType.HGVS, DirectHgvs.ErrorMessage: not null };
                                }
                                @if (isLoading)
                                {
                                    <span>⏳ @tab.DisplayLabel</span>
                                }
                                else if (hasError)
                                {
                                    <span style="color: var(--color-red-light);">⚠️ @tab.DisplayLabel</span>
                                }
                                else
                                {
                                    <span style="color: var(--color-green-light);">✓ @tab.DisplayLabel</span>
                                }
                            </button>
                        </li>
                    }
                </ul>

                <div class="tab-content-container">
                    @for (var i = 0; i < _inputTabs.Count; i++)
                    {
                        var tab = _inputTabs[i];
                        
                        <div class="@(i == _activeTabIndex ? "d-block fade-in-up" : "d-none")">
                            @if (tab.IsLoading)
                            {
                                <div class="text-center py-5">
                                    <Spinner Type="SpinnerType.Dots" Color="SpinnerColor.Primary" />
                                    <p class="mt-4 text-muted" style="font-size: 1.0625rem;">Loading data for @tab.DisplayLabel...</p>
                                </div>
                            }
                            else if (tab.ErrorMessage != null)
                            {
                                <div class="alert alert-danger" role="alert">
                                    <strong style="color: var(--text-primary);">⚠️ Error loading data for @tab.DisplayLabel:</strong><br/>
                                    <span style="margin-top: 0.5rem; display: block;">@tab.ErrorMessage</span>
                                </div>
                            }
                            else if (tab.Type == InputType.HGVS && tab.DirectHgvs != null)
                            {
                                <HgvsDetailPanel 
                                    Data="tab.DirectHgvs" 
                                    OnSort="SortBy" 
                                    GetSorted="GetSortedGRNAs" 
                                    OnCreateGrna="HandlegRNACreationButton"
                                    OnCopyComplete="CopyCompleteGRNA"
                                    OnGetRnaFold="GetRnaFolding" />
                            }
                            else if (tab.Type == InputType.RS && tab.ChildHgvsList != null)
                            {
                                @if (tab.ChildHgvsList.Any())
                                {
                                    <!-- Second level tabs for RS child HGVS -->
                                    <ul class="nav nav-tabs nav-tabs-sm" role="tablist">
                                        @for (int j = 0; j < tab.ChildHgvsList.Count; j++)
                                        {
                                            var childIndex = j;
                                            var childHgvs = tab.ChildHgvsList[j];
                                            var isActiveChild = _activeChildTabIndices.TryGetValue(i, out var activeChild) && activeChild == childIndex;
                                            
                                            <li class="nav-item" role="presentation">
                                                <button class="nav-link @(isActiveChild ? "active" : "")" 
                                                        type="button"
                                                        @onclick="() => _activeChildTabIndices[i] = childIndex">
                                                    @if (childHgvs.IsLoading)
                                                    {
                                                        <span>⏳ @childHgvs.Hgvs[..Math.Min(20, childHgvs.Hgvs.Length)]@(childHgvs.Hgvs.Length > 20 ? "..." : "")</span>
                                                    }
                                                    else if (childHgvs.ErrorMessage != null)
                                                    {
                                                        <span style="color: var(--color-red-light);">⚠️ @childHgvs.Hgvs[..Math.Min(20, childHgvs.Hgvs.Length)]@(childHgvs.Hgvs.Length > 20 ? "..." : "")</span>
                                                    }
                                                    else
                                                    {
                                                        <span style="color: var(--color-green-light);">✓ @childHgvs.Hgvs[..Math.Min(20, childHgvs.Hgvs.Length)]@(childHgvs.Hgvs.Length > 20 ? "..." : "")</span>
                                                    }
                                                </button>
                                            </li>
                                        }
                                    </ul>
                                    
                                    <div class="tab-content-container tab-content-container-nested">
                                        @for (int j = 0; j < tab.ChildHgvsList.Count; j++)
                                        {
                                            var childIndex = j;
                                            var childHgvs = tab.ChildHgvsList[j];
                                            var isActiveChild = _activeChildTabIndices.TryGetValue(i, out var activeChild) && activeChild == childIndex;
                                            
                                            <div class="@(isActiveChild ? "d-block fade-in-up" : "d-none")">
                                                <HgvsDetailPanel 
                                                    Data="childHgvs" 
                                                    OnSort="SortBy" 
                                                    GetSorted="GetSortedGRNAs" 
                                                    OnCreateGrna="HandlegRNACreationButton"
                                                    OnCopyComplete="CopyCompleteGRNA"
                                                    OnGetRnaFold="GetRnaFolding" />
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-info" role="alert">
                                        <strong style="color: var(--text-primary);">ℹ️ No HGVS variants found for @tab.DisplayLabel</strong>
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    // Logic moved to Index.razor.cs
}
