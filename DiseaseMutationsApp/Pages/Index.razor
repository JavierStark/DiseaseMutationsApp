@page "/"
@using DiseaseMutationsApp.Services
@using DiseaseMutationsApp.Pages
@using BlazorBootstrap

<PageTitle>gRNA Builder</PageTitle>

<div class="container-fluid px-4 py-4" style="max-width: 1400px;">
    <div class="row mb-4">
        <div class="col">
            <h1 class="mb-4">gRNA Builder</h1>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-lg-8 col-xl-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-3">Input Parameters</h5>
                    <div class="mb-3">
                        <label for="hgvs" class="form-label">HGVS or RS codes (comma-separated for multiple):</label>
                        <textarea id="hgvs" class="form-control" @bind="_hgvs" rows="5" placeholder="e.g., NG_016465.4:g.98765C>T, rs12345, NG_056131.3:g.755G>A&#10;You can enter multiple HGVS or RS codes separated by commas"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="before" class="form-label">gRNA size:</label>
                        <input id="before" type="number" class="form-control" @bind="_gRnaSize" min="1" style="max-width: 200px;"/>
                    </div>
                    <button class="btn btn-primary btn-lg mt-2" @onclick="FetchData">
                        <span>Fetch Data</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (_inputTabs.Any())
    {
        <div class="row mb-4">
            <div class="col">
                <ul class="nav nav-tabs" role="tablist">
                    @for (var i = 0; i < _inputTabs.Count; i++)
                    {
                        var index = i;
                        var tab = _inputTabs[i];
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(index == _activeTabIndex ? "active" : "")" 
                                    type="button" 
                                    @onclick="() => _activeTabIndex = index">
                                @{
                                    var isLoading = tab.IsLoading || tab is { Type: InputType.HGVS, DirectHgvs.IsLoading: true };
                                    var hasError = tab.ErrorMessage != null || tab is { Type: InputType.HGVS, DirectHgvs.ErrorMessage: not null };
                                }
                                @if (isLoading)
                                {
                                    <span>⏳ @tab.DisplayLabel</span>
                                }
                                else if (hasError)
                                {
                                    <span style="color: #dc3545;">⚠️ @tab.DisplayLabel</span>
                                }
                                else
                                {
                                    <span>✓ @tab.DisplayLabel</span>
                                }
                            </button>
                        </li>
                    }
                </ul>

                <div class="tab-content mt-3">
                    @for (var i = 0; i < _inputTabs.Count; i++)
                    {
                        var index = i;
                        var tab = _inputTabs[i];
                        
                        <div class="@(index == _activeTabIndex ? "d-block" : "d-none")">
                            @if (tab.IsLoading)
                            {
                                <div class="card shadow-sm">
                                    <div class="card-body text-center py-5">
                                        <Spinner Type="SpinnerType.Dots" Color="SpinnerColor.Primary" />
                                        <p class="mt-3 text-muted">Loading data for @tab.DisplayLabel...</p>
                                    </div>
                                </div>
                            }
                            else if (tab.ErrorMessage != null)
                            {
                                <div class="alert alert-danger" role="alert">
                                    <strong>Error loading data for @tab.DisplayLabel:</strong><br/>
                                    @tab.ErrorMessage
                                </div>
                            }
                            else if (tab.Type == InputType.HGVS && tab.DirectHgvs != null)
                            {
                                <HgvsDetailPanel 
                                    Data="tab.DirectHgvs" 
                                    OnSort="SortBy" 
                                    GetSorted="GetSortedGRNAs" 
                                    OnCreateGrna="HandlegRNACreationButton"
                                    OnCopyComplete="CopyCompleteGRNA"
                                    OnGetRnaFold="GetRnaFolding" />
                            }
                            else if (tab.Type == InputType.RS && tab.ChildHgvsList != null)
                            {
                                @if (tab.ChildHgvsList.Any())
                                {
                                    <!-- Second level tabs for RS child HGVS -->
                                    <ul class="nav nav-tabs nav-tabs-sm bg-light" role="tablist" style="border-top: 2px solid #dee2e6; padding-top: 0.5rem;">
                                        @for (int j = 0; j < tab.ChildHgvsList.Count; j++)
                                        {
                                            var childIndex = j;
                                            var childHgvs = tab.ChildHgvsList[j];
                                            var isActiveChild = _activeChildTabIndices.TryGetValue(index, out var activeChild) && activeChild == childIndex;
                                            
                                            <li class="nav-item" role="presentation">
                                                <button class="nav-link @(isActiveChild ? "active" : "")" 
                                                        type="button" 
                                                        style="font-size: 0.9rem;"
                                                        @onclick="() => _activeChildTabIndices[index] = childIndex">
                                                    @if (childHgvs.IsLoading)
                                                    {
                                                        <span>⏳ @childHgvs.Hgvs[..Math.Min(20, childHgvs.Hgvs.Length)]@(childHgvs.Hgvs.Length > 20 ? "..." : "")</span>
                                                    }
                                                    else if (childHgvs.ErrorMessage != null)
                                                    {
                                                        <span style="color: #dc3545;">⚠️ @childHgvs.Hgvs[..Math.Min(20, childHgvs.Hgvs.Length)]@(childHgvs.Hgvs.Length > 20 ? "..." : "")</span>
                                                    }
                                                    else
                                                    {
                                                        <span>✓ @childHgvs.Hgvs[..Math.Min(20, childHgvs.Hgvs.Length)]@(childHgvs.Hgvs.Length > 20 ? "..." : "")</span>
                                                    }
                                                </button>
                                            </li>
                                        }
                                    </ul>
                                    
                                    <div class="mt-3">
                                        @for (int j = 0; j < tab.ChildHgvsList.Count; j++)
                                        {
                                            var childIndex = j;
                                            var childHgvs = tab.ChildHgvsList[j];
                                            var isActiveChild = _activeChildTabIndices.TryGetValue(index, out var activeChild) && activeChild == childIndex;
                                            
                                            <div class="@(isActiveChild ? "d-block" : "d-none")">
                                                <HgvsDetailPanel 
                                                    Data="childHgvs" 
                                                    OnSort="SortBy" 
                                                    GetSorted="GetSortedGRNAs" 
                                                    OnCreateGrna="HandlegRNACreationButton"
                                                    OnCopyComplete="CopyCompleteGRNA"
                                                    OnGetRnaFold="GetRnaFolding" />
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-info" role="alert">
                                        <strong>No HGVS variants found for @tab.DisplayLabel</strong>
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    // Logic moved to Index.razor.cs
}
