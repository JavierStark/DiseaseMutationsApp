@page "/"
@using DiseaseMutationsApp.Services

<PageTitle>Diana</PageTitle>

<div class="container-max-xl">
    <header class="page-header">
        <h1 class="page-title" tabindex="-1">Diana</h1>
        <div class="page-rail" aria-hidden="true"></div>
        <p class="page-lede">Design and rank Cas13 guide RNA spacers for disease variants, with off-target and structure checks.</p>
    </header>

    <div class="row mb-4">
        <div class="col-lg-9 col-xl-7">
            <div class="card">
                <div class="card-body">
                    <h2 class="card-title section-title"><Icon Name="settings" />Input parameters</h2>

                    @if (_linkBanner)
                    {
                        <div class="alert alert-info" role="status">
                            <Icon Name="info" />This page was opened from a link, which only fills in the form. Check the variants and parameters, then press <strong>Run analysis</strong>.
                        </div>
                    }

                    @if (_incoming is { } incoming)
                    {
                        <div class="alert alert-info" role="status" id="incoming-banner">
                            <Icon Name="info" />@incoming.Message Check the inputs, then press <strong>Run analysis</strong>.
                        </div>
                    }

                    @if (_restoredBanner)
                    {
                        <div class="alert alert-info" role="status">
                            <Icon Name="info" />Your previous inputs were restored. Results are not stored in the browser: press <strong>Run analysis</strong>
                            to recompute them, and download the CSV report to keep them.
                        </div>
                    }

                    <div class="mb-4">
                        <label for="hgvs" class="form-label" title="@HelpText.Variants">HGVS or rs codes (comma-separated for several)</label>
                        <div class="input-with-clear">
                            <textarea id="hgvs" class="form-control" @bind="_hgvs" @bind:event="oninput" @bind:after="OnInputChanged" rows="4" maxlength="8000"
                                      placeholder="NG_008690.2:g.123012G>T, rs12345"></textarea>
                            <button type="button" class="btn btn-outline-secondary btn-icon-only" @onclick="ClearInput" disabled="@string.IsNullOrWhiteSpace(_hgvs)"
                                    aria-label="Clear inputs" title="Clear the input box and the saved browser copy">
                                <Icon Name="close" />
                            </button>
                        </div>
                        <small class="helper-note mt-2 d-block">One or more variants. An rsID is resolved to its HGVS notations (by default only the disease-relevant allele on the main gene record) and analysed on both strands; the tab that targets the gene's mRNA comes first.</small>
                        <div class="form-check mt-2">
                            <input id="all-alleles" class="form-check-input" type="checkbox" checked="@_showAllAlleles" @onchange="OnShowAllAllelesChanged" />
                            <label class="form-check-label" for="all-alleles" title="@HelpText.ShowAllAlleles">Show all alleles and gene records of an rsID</label>
                        </div>
                    </div>

                    <fieldset class="mb-4">
                        <legend class="form-label" title="@HelpText.SpacerAndSeed">Spacer, seed region and substitution rule</legend>
                        <div class="row g-3">
                            <div class="col-sm-4">
                                <label for="grna-size" class="form-label" title="@HelpText.SpacerSize">Spacer size</label>
                                <input id="grna-size" type="number" class="form-control" @bind="_gRnaSize" @bind:after="OnInputChanged" min="@Main.MinSpacerSize" max="@Main.MaxSpacerSize" />
                            </div>
                            <div class="col-sm-4">
                                <label for="seed-start" class="form-label" title="@HelpText.SeedRegion">Seed start (inclusive)</label>
                                <input id="seed-start" type="number" class="form-control" @bind="_seedStart" @bind:after="OnInputChanged" min="0" max="@(_gRnaSize > 0 ? _gRnaSize - 1 : 0)" />
                            </div>
                            <div class="col-sm-4">
                                <label for="seed-end" class="form-label" title="@HelpText.SeedRegion">Seed end (inclusive)</label>
                                <input id="seed-end" type="number" class="form-control" @bind="_seedEnd" @bind:after="OnInputChanged" min="0" max="@(_gRnaSize > 0 ? _gRnaSize - 1 : 0)" />
                            </div>
                        </div>
                        <div class="row g-3 mt-1">
                            <div class="col-sm-6">
                                <label for="snp-pos" class="form-label" title="@HelpText.SnpPos">Variant position from the spacer's 3' end</label>
                                <input id="snp-pos" type="number" class="form-control" @bind="_snpPos" @bind:after="OnInputChanged" min="1" max="@_gRnaSize" />
                            </div>
                            <div class="col-sm-6">
                                <label for="mismatch-pos" class="form-label" title="@HelpText.MismatchPos">Engineered mismatch position from the 3' end</label>
                                <input id="mismatch-pos" type="number" class="form-control" @bind="_mismatchPos" @bind:after="OnInputChanged" min="1" max="@_gRnaSize" />
                            </div>
                        </div>
                        <small class="helper-note mt-2 d-block">Substitution rule: the spacer built with the variant at the first position and one deliberate extra mismatch at the second. Positions count from the spacer's 3' end (1 = last letter); defaults 3 and 4. To use a position counted from the 5' end, enter spacer size - position + 1.</small>
                        @if (RuleValidationMessage != null)
                        {
                            <small class="text-danger mt-2 d-block" role="alert">@RuleValidationMessage</small>
                        }
                        @if (InputCountMessage != null)
                        {
                            <small class="text-danger mt-2 d-block" role="alert">@InputCountMessage</small>
                        }
                        @if (SeedRangeValidationMessage != null)
                        {
                            <small class="text-danger mt-2 d-block" role="alert">@SeedRangeValidationMessage</small>
                        }
                    </fieldset>

                    <div class="mb-4">
                        <label for="upload" class="form-label" title="@HelpText.LoadFile">Load inputs from a file</label>
                        <InputFile id="upload" class="form-control" accept=".txt,.csv,.tsv,.json" OnChange="OnFileSelected" />
                        <small class="helper-note mt-2 d-block">A plain list of HGVS/rsIDs, a Builder CSV report, or a saved session (.json).</small>
                        @if (_uploadMessage != null)
                        {
                            <small class="d-block mt-1" role="status">@_uploadMessage</small>
                        }
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-primary btn-lg" @onclick="StartRun" disabled="@(!CanFetchData)">
                            <Icon Name="play" />Run analysis
                        </button>
                        @if (Runner.IsBusy)
                        {
                            <button type="button" class="btn btn-outline-secondary btn-lg" @onclick="CancelRun">
                                <Icon Name="stop" />Cancel run
                            </button>
                        }
                        <button type="button" class="btn btn-outline-secondary btn-lg" title="@HelpText.SaveSession" @onclick="DownloadSession" disabled="@string.IsNullOrWhiteSpace(_hgvs)">
                            <Icon Name="download" />Save session
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-lg" title="@HelpText.Permalink" @onclick="CopyPermalink" disabled="@string.IsNullOrWhiteSpace(_hgvs)">
                            <Icon Name="@(_linkCopied ? "check" : "link")" />@(_linkCopied ? "Link copied" : "Copy link to this design")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (StateService.Shortlist.Count > 0)
    {
        <div class="card mb-4" id="shortlist" tabindex="-1">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <h2 class="card-title section-title mb-0" title="@HelpText.Shortlist"><Icon Name="list" />Shortlist <span class="shortlist-badge">@StateService.Shortlist.Count</span></h2>
                    <div class="d-flex flex-wrap align-items-center gap-3">
                        <div class="form-check mb-0"><input id="oligo-t7" class="form-check-input" type="checkbox" @bind="_oligoT7" /><label class="form-check-label" for="oligo-t7" title="@HelpText.T7">T7 promoter</label></div>
                        <div class="form-check mb-0"><input id="oligo-pairs" class="form-check-input" type="checkbox" @bind="_oligoPairs" /><label class="form-check-label" for="oligo-pairs" title="@HelpText.Pairs">Top and bottom oligos</label></div>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="DownloadOligos"><Icon Name="download" />Order CSV (DNA)</button>
                        <button type="button" class="btn btn-sm btn-primary" @onclick="SendShortlistToPooling"><Icon Name="send" />Send to Pooling</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="StateService.ClearShortlist"><Icon Name="trash" />Clear</button>
                    </div>
                </div>
                <div class="grna-table-wrap" tabindex="0" role="region" aria-label="Shortlist, scrollable">
                    <table class="table table-sm grna-table">
                        <caption class="visually-hidden">Shortlisted spacers</caption>
                        <thead>
                        <tr>
                            <th scope="col">Variant</th>
                            <th scope="col" title="@HelpText.StrandBoth">Strand</th>
                            <th scope="col">Spacer</th>
                            <th scope="col" class="num" title="@HelpText.Score">Score</th>
                            <th scope="col" title="@HelpText.Alignments">Alignments</th>
                            <th scope="col" title="@HelpText.Assembly">Assembly compatibility</th>
                            <th scope="col"><span class="visually-hidden">Remove</span></th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in StateService.Shortlist)
                        {
                            var risk = AlignmentRisk.Describe(item.Alignments);
                            <tr @key="@($"{item.Hgvs}|{item.IsComplement}")">
                                <td class="font-monospace">@item.Hgvs</td>
                                <td>@(item.IsComplement ? "Complement" : "Normal")</td>
                                <td class="seq-cell">@item.Spacer @{ var sites = RestrictionSites.ForGuide(item.Spacer, _oligoT7); }<RestrictionChip Enzymes="sites" /></td>
                                <td class="num">@item.Score.ToString("P0")</td>
                                <td><span class="risk-chip @risk.CssClass"><span class="risk-glyph" aria-hidden="true"></span>@risk.Label</span></td>
                                <td><AssemblyCompatibilityBadges Found="sites" ShowLabel="false" /></td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-outline-secondary btn-icon-only" aria-label="Remove @item.Hgvs from shortlist"
                                            @onclick="() => StateService.RemoveFromShortlist(item.Hgvs, item.IsComplement)"><Icon Name="close" /></button>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <ErrorBoundary>
        <ChildContent>
            @if (_inputTabs.Count > 0)
            {
                var progress = Runner.GetProgress();
                var anyHasResults = _inputTabs.Any(HasResults);
                var reportsReady = anyHasResults && !Runner.IsBusy;

                <div class="run-bar" role="status" aria-live="polite">
                    <span class="run-bar-text">
                        @switch (Runner.Phase)
                        {
                            case RunPhase.Discovering: <text>Resolving rsIDs&hellip;</text> break;
                            case RunPhase.Analyzing: <text>Analysing @progress.Finished of @progress.Total variants</text> break;
                            case RunPhase.Cancelled: <text>Run cancelled: @progress.Done of @progress.Total variants finished</text> break;
                            default: <text>Done: @progress.Done of @progress.Total variants analysed@(progress.Failed > 0 ? $", {progress.Failed} failed" : "")</text> break;
                        }
                    </span>
                    @if (progress.Total > 0)
                    {
                        <progress max="@progress.Total" value="@progress.Finished" aria-label="Analysis progress"></progress>
                    }
                    @if (anyHasResults)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(!reportsReady)" @onclick="DownloadAllReports">
                            <Icon Name="download" />Download all reports
                        </button>
                    }
                </div>

                <TabStrip TItem="InputTabData" Items="_inputTabs" KeyOf="Key" ActiveKey="@(ActiveTab is null ? null : Key(ActiveTab))"
                          ActiveKeyChanged="SelectTab" IdPrefix="input" AriaLabel="Analysed inputs">
                    <ItemTemplate Context="tab">
                        <TabStatusLabel Label="@tab.DisplayLabel" State="StateOf(tab)" />
                    </ItemTemplate>
                </TabStrip>

                @if (ActiveTab is { } tab)
                {
                    <div class="tab-panel fade-in" role="tabpanel" id="@InputPanelId(tab)"
                         aria-labelledby="@InputTabId(tab)" @key="tab.Id">
                        @if (tab.IsLoading)
                        {
                            <div role="status" aria-live="polite">
                                <p class="text-muted">Looking up <span class="font-monospace">@tab.DisplayLabel</span>&hellip;</p>
                                <div class="skeleton skeleton-block" aria-hidden="true"></div>
                                <div class="skeleton skeleton-row" aria-hidden="true"></div>
                            </div>
                        }
                        else if (tab.ErrorMessage != null)
                        {
                            <div class="alert alert-danger" role="alert">
                                <div class="alert-heading"><Icon Name="alert" />Could not load <span class="font-monospace">@tab.DisplayLabel</span></div>
                                <div>@tab.ErrorMessage</div>
                            </div>
                        }
                        else if (tab.Type == InputType.HGVS && tab.DirectHgvs != null)
                        {
                            <div class="d-flex justify-content-end mb-2">
                                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(Runner.IsBusy || !HasResults(tab))" @onclick="() => DownloadReport(tab)">
                                    <Icon Name="download" />Download report
                                </button>
                            </div>
                            <ErrorBoundary @key="tab.DirectHgvs.Id">
                                <ChildContent>
                                    <HgvsDetailPanel @key="tab.DirectHgvs.Id" Data="tab.DirectHgvs" SeedStart="_seedStart" SeedEnd="_seedEnd" />
                                </ChildContent>
                                <ErrorContent>
                                    <div class="error-boundary" role="alert"><h3>Could not display this variant</h3><p class="mb-0">Switch tabs to continue; the other variants are unaffected.</p></div>
                                </ErrorContent>
                            </ErrorBoundary>
                        }
                        else if (tab.Type == InputType.RS && tab.ChildHgvsList != null)
                        {
                            @if (tab.ChildHgvsList.Count > 0)
                            {
                                var activeLeaf = ActiveLeaf(tab)!;
                                var tabReady = tab.ChildHgvsList.All(h => !h.IsLoading);
                                var tabHasResults = tab.ChildHgvsList.Any(h => h.GRNAs is { Count: > 0 });

                                <div class="d-flex justify-content-end mb-2">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(!tabReady || !tabHasResults)" @onclick="() => DownloadReport(tab)">
                                        <Icon Name="download" />Download report
                                    </button>
                                </div>

                                <TabStrip TItem="HgvsData" Items="tab.ChildHgvsList" KeyOf="Key" ActiveKey="@Key(activeLeaf)"
                                          ActiveKeyChanged="k => SelectLeaf(tab, k)" IdPrefix="@LeafPrefix(tab)" AriaLabel="@LeafLabel(tab)" Small="true">
                                    <ItemTemplate Context="leaf">
                                        <TabStatusLabel Label="@leaf.Hgvs" State="StateOf(leaf)" IsComplement="leaf.IsComplement" Gene="@leaf.Gene" TargetsMrna="leaf.TargetsMrna" />
                                    </ItemTemplate>
                                </TabStrip>

                                <div class="tab-panel" role="tabpanel" id="@LeafPanelId(tab, activeLeaf)"
                                     aria-labelledby="@LeafTabId(tab, activeLeaf)" @key="activeLeaf.Id">
                                    <ErrorBoundary @key="activeLeaf.Id">
                                        <ChildContent>
                                            <HgvsDetailPanel @key="activeLeaf.Id" Data="activeLeaf" RsId="@tab.RsId" SeedStart="_seedStart" SeedEnd="_seedEnd" />
                                        </ChildContent>
                                        <ErrorContent>
                                            <div class="error-boundary" role="alert"><h3>Could not display this variant</h3><p class="mb-0">Switch tabs to continue; the other variants are unaffected.</p></div>
                                        </ErrorContent>
                                    </ErrorBoundary>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info" role="status">
                                    <div class="alert-heading"><Icon Name="info" />No HGVS notations found for @tab.DisplayLabel</div>
                                    <div>dbSNP returned no gene-level (NG_) mapping for this rsID. This is different from a failed lookup, which would be reported as an error.</div>
                                </div>
                            }
                        }
                    </div>
                }
            }
        </ChildContent>
        <ErrorContent>
            <div class="error-boundary" role="alert">
                <h3>The results area hit an error</h3>
                <p class="mb-0">The input form above still works. Run the analysis again to rebuild the results.</p>
            </div>
        </ErrorContent>
    </ErrorBoundary>
</div>
