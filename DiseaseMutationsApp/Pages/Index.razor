@page "/"
@using BlazorBootstrap
@rendermode @(new InteractiveServerRenderMode())

<PageTitle>gRNA Builder</PageTitle>

<div class="container-fluid px-4 py-4 fade-in-up container-max-xl">
    <div class="row mb-5">
        <div class="col">
            <h1 class="mb-2 page-title">
                🧬 gRNA Builder
            </h1>
            <p class="text-muted mb-0">Design and analyze guide RNA sequences for CRISPR applications</p>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-lg-9 col-xl-7">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-4 section-title-accent">
                        <span class="oi oi-cog me-2"></span>Input Parameters
                    </h5>
                    <div class="mb-4">
                        <label for="hgvs" class="form-label">HGVS or RS codes (comma-separated for multiple)</label>
                        <textarea id="hgvs" class="form-control" @bind="_hgvs" rows="5" placeholder="e.g., NG_008690.2:g.123012G>T, rs12345, . You can enter multiple HGVS or RS codes separated by commas"></textarea>
                        <small class="text-muted mt-2 d-block">Enter one or more genetic variants to analyze</small>
                    </div>
                    <div class="mb-4">
                        <label class="form-label">gRNA and Seed Region</label>
                        <div class="row g-3">
                            <div class="col-sm-4">
                                <label for="grna-size" class="form-label">Spacer size</label>
                                <input id="grna-size" type="number" class="form-control" @bind="_gRnaSize" min="1" />
                            </div>
                            <div class="col-sm-4">
                                <label for="seed-start" class="form-label">Seed start (inclusive)</label>
                                <input id="seed-start" type="number" class="form-control" @bind="_seedStart" min="0" max="@(_gRnaSize > 0 ? _gRnaSize - 1 : 0)" />
                            </div>
                            <div class="col-sm-4">
                                <label for="seed-end" class="form-label">Seed end (inclusive)</label>
                                <input id="seed-end" type="number" class="form-control" @bind="_seedEnd" min="0" max="@(_gRnaSize > 0 ? _gRnaSize - 1 : 0)" />
                            </div>
                        </div>
                        @if (SeedRangeValidationMessage != null)
                        {
                            <small class="text-danger mt-2 d-block">@SeedRangeValidationMessage</small>
                        }
                    </div>
                    <button class="btn btn-primary btn-lg mt-2" @onclick="FetchData" disabled="@(!CanFetchData)">
                        <span class="oi oi-data-transfer-download me-2"></span>
                        <span>Fetch Data</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (_inputTabs.Any())
    {
        <div class="row mb-5 fade-in-up">
            <div class="col">
                @{
                    var allRsTabs = _inputTabs.Where(t => t.Type == InputType.RS && t.ChildHgvsList != null).ToList();
                    var allRsReady = allRsTabs.Any() && allRsTabs.All(t => !t.IsLoading && t.ChildHgvsList!.All(h => !h.IsLoading));
                    var anyRsHasResults = allRsTabs.Any(t => t.ChildHgvsList!.Any(h => h.GRNAs != null && h.GRNAs.Any()));
                }
                @if (allRsTabs.Count > 0)
                {
                    <div class="d-flex justify-content-end mb-2">
                        <button class="btn btn-outline-primary shadow-sm"
                                disabled="@(!allRsReady || !anyRsHasResults)"
                                @onclick="DownloadAllRsReports"
                                title="@(allRsReady ? "Download Combined CSV Report for All RS Codes" : "Waiting for analysis...")">
                            @if (!allRsReady)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Analyzing...</span>
                            }
                            else
                            {
                                <span class="oi oi-data-transfer-download me-2"></span>
                                <span>Download All Reports</span>
                            }
                        </button>
                    </div>
                }
                <ul class="nav nav-tabs" role="tablist">
                    @for (var i = 0; i < _inputTabs.Count; i++)
                    {
                        var tabIndex = i; // Capture loop variable for closure
                        var tab = _inputTabs[i];
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(tabIndex == _activeTabIndex ? "active" : "")" 
                                    type="button" 
                                    title="@tab.DisplayLabel"
                                    @onclick="() => _activeTabIndex = tabIndex">
                                @{
                                    var isLoading = tab.IsLoading || tab is { Type: InputType.HGVS, DirectHgvs.IsLoading: true };
                                    var hasError = tab.ErrorMessage != null || tab is { Type: InputType.HGVS, DirectHgvs.ErrorMessage: not null };
                                }
                                @if (isLoading)
                                {
                                    <span>⏳ @tab.DisplayLabel</span>
                                }
                                else if (hasError)
                                {
                                    <span class="tab-state-error">⚠️ @tab.DisplayLabel</span>
                                }
                                else
                                {
                                    <span class="tab-state-success">✓ @tab.DisplayLabel</span>
                                }
                            </button>
                        </li>
                    }
                </ul>

                <div class="tab-content-container">
                    @for (var i = 0; i < _inputTabs.Count; i++)
                    {
                        var tabIndex = i; // Capture loop variable for closure
                        var tab = _inputTabs[tabIndex];
                        
                        <div class="@(tabIndex == _activeTabIndex ? "d-block fade-in-up" : "d-none")">
                            @if (tab.IsLoading)
                            {
                                <div class="text-center py-5">
                                    <Spinner Type="SpinnerType.Dots" Color="SpinnerColor.Primary" />
                                    <p class="mt-4 text-muted loading-description">Loading data for @tab.DisplayLabel...</p>
                                </div>
                            }
                            else if (tab.ErrorMessage != null)
                            {
                                <div class="alert alert-danger" role="alert">
                                    <strong class="alert-heading">⚠️ Error loading data for @tab.DisplayLabel:</strong><br/>
                                    <span class="alert-detail">@tab.ErrorMessage</span>
                                </div>
                            }
                            else if (tab.Type == InputType.HGVS && tab.DirectHgvs != null)
                            {
                                <HgvsDetailPanel 
                                    Data="tab.DirectHgvs" 
                                    OnSort="SortBy"
                                    GetSorted="GetSortedGRNAs"
                                    OnSortOriginal="SortByOriginal"
                                    GetSortedOriginal="GetSortedOriginalGRNAs"
                                    OnCreateGrna="HandlegRNACreationButton"
                                    OnCopyComplete="CopyCompleteGRNA"
                                    OnGetRnaFold="GetRnaFolding"
                                    SeedStart="_seedStart"
                                    SeedEnd="_seedEnd" />
                            }
                            else if (tab.Type == InputType.RS && tab.ChildHgvsList != null)
                            {
                                @if (tab.ChildHgvsList.Any())
                                {
                                    <div class="d-flex justify-content-end mb-2 fade-in-up">
                                        @{
                                            var isReady = tab.ChildHgvsList.All(h => !h.IsLoading);
                                            var hasResults = tab.ChildHgvsList.Any(h => h.GRNAs != null && h.GRNAs.Any());
                                        }
                                        <button class="btn btn-outline-primary shadow-sm"
                                                disabled="@(!isReady || !hasResults)"
                                                @onclick="() => DownloadReport(tab)"
                                                title="@(isReady ? "Download CSV Report" : "Waiting for analysis...")">
                                            @if (!isReady)
                                            {
                                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                                <span>Analyzing...</span>
                                            }
                                            else
                                            {
                                                <span class="oi oi-data-transfer-download me-2"></span>
                                                <span>Download Report</span>
                                            }
                                        </button>
                                    </div>

                                    <!-- Second level tabs for RS child HGVS -->
                                    <ul class="nav nav-tabs nav-tabs-sm" role="tablist">
                                        @for (int j = 0; j < tab.ChildHgvsList.Count; j++)
                                        {
                                            var childIndex = j;
                                            var childHgvs = tab.ChildHgvsList[j];
                                            var isActiveChild = _activeChildTabIndices.TryGetValue(tabIndex, out var activeChild) && activeChild == childIndex;
                                            
                                            <li class="nav-item" role="presentation">
                                                <button class="nav-link @(isActiveChild ? "active" : "")" 
                                                        type="button"
                                                        title="@childHgvs.Hgvs"
                                                        @onclick="() => _activeChildTabIndices[tabIndex] = childIndex">
                                                    @if (childHgvs.IsLoading)
                                                    {
                                                        @if (childHgvs.IsComplement)
                                                        {
                                                            var maxLen = 16;
                                                            var label = childHgvs.Hgvs.Length > maxLen ? childHgvs.Hgvs[..maxLen] + "..." : childHgvs.Hgvs;
                                                            <span>⏳ @label (C)</span>
                                                        }
                                                        else
                                                        {
                                                            var maxLen = 18;
                                                            var label = childHgvs.Hgvs.Length > maxLen ? childHgvs.Hgvs[..maxLen] + "..." : childHgvs.Hgvs;
                                                            <span>⏳ @label</span>
                                                        }
                                                    }
                                                    else if (childHgvs.ErrorMessage != null)
                                                    {
                                                        @if (childHgvs.IsComplement)
                                                        {
                                                            var maxLen = 16;
                                                            var label = childHgvs.Hgvs.Length > maxLen ? childHgvs.Hgvs[..maxLen] + "..." : childHgvs.Hgvs;
                                                            <span class="tab-state-error">⚠️ @label (C)</span>
                                                        }
                                                        else
                                                        {
                                                            var maxLen = 18;
                                                            var label = childHgvs.Hgvs.Length > maxLen ? childHgvs.Hgvs[..maxLen] + "..." : childHgvs.Hgvs;
                                                            <span class="tab-state-error">⚠️ @label</span>
                                                        }
                                                    }
                                                    else if (childHgvs.IsComplement)
                                                    {
                                                        var maxLen = 16;
                                                        var label = childHgvs.Hgvs.Length > maxLen ? childHgvs.Hgvs[..maxLen] + "..." : childHgvs.Hgvs;
                                                        <span class="tab-state-complement">↕ @label (C)</span>
                                                    }
                                                    else
                                                    {
                                                        var maxLen = 18;
                                                        var label = childHgvs.Hgvs.Length > maxLen ? childHgvs.Hgvs[..maxLen] + "..." : childHgvs.Hgvs;
                                                        <span class="tab-state-success">✓ @label</span>
                                                    }
                                                </button>
                                            </li>
                                        }
                                    </ul>
                                    
                                    <div class="tab-content-container tab-content-container-nested">
                                        @for (int j = 0; j < tab.ChildHgvsList.Count; j++)
                                        {
                                            var childIndex = j;
                                            var childHgvs = tab.ChildHgvsList[j];
                                            var isActiveChild = _activeChildTabIndices.TryGetValue(tabIndex, out var activeChild) && activeChild == childIndex;
                                            
                                            <div class="@(isActiveChild ? "d-block fade-in-up" : "d-none")">
                                                <HgvsDetailPanel
                                                    Data="childHgvs"
                                                    OnSort="SortBy"
                                                    GetSorted="GetSortedGRNAs"
                                                    OnSortOriginal="SortByOriginal"
                                                    GetSortedOriginal="GetSortedOriginalGRNAs"
                                                    OnCreateGrna="HandlegRNACreationButton"
                                                    OnCopyComplete="CopyCompleteGRNA"
                                                    OnGetRnaFold="GetRnaFolding"
                                                    SeedStart="_seedStart"
                                                    SeedEnd="_seedEnd" />
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-info" role="alert">
                                        <strong class="alert-heading">ℹ️ No HGVS variants found for @tab.DisplayLabel</strong>
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    // Logic moved to Index.razor.cs
}
