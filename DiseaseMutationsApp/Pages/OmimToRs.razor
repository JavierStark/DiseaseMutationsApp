@page "/omim-to-rs"
@using DiseaseMutationsApp.Services
@inject IDiseaseMutationsApi Api
@inject NavigationManager Nav
@inject AppStateService StateService
@implements IDisposable

<PageTitle>Omim to RS</PageTitle>

<div class="container-fluid px-4 py-4 fade-in-up" style="max-width: 1200px;">
    <div class="row mb-5">
        <div class="col">
            <h1 class="mb-2" style="background: linear-gradient(135deg, #06B6D4 0%, #A855F7 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
                🔍 OMIM to RS Converter
            </h1>
            <p class="text-muted mb-0">Enter an OMIM code to fetch associated RS IDs for genetic variant analysis</p>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-lg-8 col-xl-7">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-4" style="color: var(--color-teal-light);">
                        <span class="oi oi-magnifying-glass me-2"></span>Search Parameters
                    </h5>
                    <div class="mb-4">
                        <label for="omim" class="form-label">OMIM code</label>
                        <input id="omim" type="number" class="form-control" @bind="_omim" min="1" placeholder="e.g., 605543" style="max-width: 300px;" />
                        <small class="text-muted mt-2 d-block">Enter a valid Online Mendelian Inheritance in Man (OMIM) identifier</small>
                    </div>
                    <button class="btn btn-primary btn-lg" @onclick="FetchRs" disabled="@_isLoading">
                        @if (_isLoading)
                        {
                            <span>⏳ Loading...</span>
                        }
                        else
                        {
                            <span class="oi oi-magnifying-glass me-2"></span>
                            <span>Fetch RS IDs</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (_errorMessage != null)
    {
        <div class="alert alert-danger fade-in-up" role="alert">
            <strong style="color: var(--text-primary);">⚠️ Error:</strong><br />
            <span style="margin-top: 0.5rem; display: block;">@_errorMessage</span>
        </div>
    }

    @if (_rsList?.Any() == true)
    {
        <div class="row mb-4 fade-in-up">
            <div class="col d-flex justify-content-between align-items-center flex-wrap gap-3">
                <h5 class="mb-0" style="color: var(--color-green-light);">
                    <span class="oi oi-check me-2"></span>Found @_rsList.Count RS ID@(_rsList.Count != 1 ? "s" : "")
                </h5>
                <div>
                    <button class="btn btn-success btn-sm" @onclick="OpenSelectedInBuilder" disabled="@(!_selectedRs.Any())" title="Open selected RS in gRNA Builder">
                        <span class="oi oi-arrow-right me-1"></span>
                        Open selected in gRNA Builder (@_selectedRs.Count)
                    </button>
                </div>
            </div>
        </div>
        <div class="row fade-in-up">
            <div class="col">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover table-striped align-middle mb-0">
                                <thead class="table-light">
                                <tr>
                                    <th style="width: 60px; text-align: center;">
                                        <span class="oi oi-check" style="font-size: 0.875rem;"></span>
                                    </th>
                                    <th style="width: 160px;">RS ID</th>
                                    <th>Action</th>
                                </tr>
                                </thead>
                                <tbody>
                                @foreach (var rs in _rsList)
                                {
                                    var rsValue = string.IsNullOrWhiteSpace(rs) ? rs : (rs.StartsWith("rs", StringComparison.OrdinalIgnoreCase) ? rs.ToLowerInvariant() : $"rs{rs}");
                                    var isChecked = _selectedRs.Contains(rsValue);
                                    <tr>
                                        <td style="text-align: center;">
                                            <input type="checkbox" class="form-check-input" checked="@isChecked" @onchange="(e) => ToggleSelection(rsValue, e.Value as bool? == true)" style="cursor: pointer;" />
                                        </td>
                                        <td class="font-monospace" style="color: var(--color-teal-light); font-weight: 500;">@rsValue</td>
                                        <td>
                                            <a class="btn btn-sm btn-secondary" href="/@(UrlEncodeQueryParam("rs", rsValue))" title="Open in gRNA Builder">
                                                <span class="oi oi-external-link me-1"></span>
                                                Open gRNA Builder
                                            </a>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    // Use properties that bind to state service
    private int? _omim
    {
        get => StateService.OmimCode;
        set => StateService.OmimCode = value;
    }

    private List<string>? _rsList
    {
        get => StateService.OmimRsList;
        set => StateService.OmimRsList = value;
    }

    private HashSet<string> _selectedRs => StateService.OmimSelectedRs;

    private string? _errorMessage
    {
        get => StateService.OmimErrorMessage;
        set => StateService.OmimErrorMessage = value;
    }

    private bool _isLoading;

    protected override void OnInitialized()
    {
        // Subscribe to state changes
        StateService.OnStateChanged += StateHasChanged;
    }

    public void Dispose()
    {
        // Unsubscribe from state changes to prevent memory leaks
        StateService.OnStateChanged -= StateHasChanged;
    }

    private async Task FetchRs()
    {
        _errorMessage = null;
        _rsList = null;
        _selectedRs.Clear();

        if (_omim is null or <= 0)
        {
            _errorMessage = "Please enter a valid positive OMIM code.";
            return;
        }

        try
        {
            _isLoading = true;
            StateHasChanged();
            var unfilteredRS = await Api.GetRsFromOmim(_omim.Value);
            
            _rsList = await FilterAvailableRS(unfilteredRS);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error fetching RS from OMIM: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<List<string>?> FilterAvailableRS(List<string> unfilteredRs)
    {
        var filtered = new List<string>();
        foreach (var rs in unfilteredRs)
        {
            var hgvs = await Api.GetHgvsFromSnp(rs[2..]);
            
            if (hgvs.Count != 0)
                filtered.Add(rs);
        }

        return filtered;
    }

    private void ToggleSelection(string rsValue, bool selected)
    {
        if (string.IsNullOrWhiteSpace(rsValue)) return;
        if (selected)
        {
            _selectedRs.Add(rsValue);
        }
        else
        {
            _selectedRs.Remove(rsValue);
        }
    }

    private void OpenSelectedInBuilder()
    {
        if (!_selectedRs.Any()) return;
        // Join selected RS with commas; Index.razor supports comma-separated inputs
        var joined = string.Join(",", _selectedRs.Select(r => r.Trim()).Where(r => !string.IsNullOrWhiteSpace(r)));
        var url = "/" + UrlEncodeQueryParam("rs", joined);
        Nav.NavigateTo(url);
    }

    private static string UrlEncodeQueryParam(string key, string value)
    {
        // Build a URL like "/?rs=rs123,rs456" safely
        var encodedKey = Uri.EscapeDataString(key);
        var encodedValue = Uri.EscapeDataString(value);
        return $"?{encodedKey}={encodedValue}";
    }
}
