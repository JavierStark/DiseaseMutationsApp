@using DiseaseMutationsApp.Services
@using DiseaseMutationsApp.Pages

<div class="card">
    <div class="card-body">
        <h2 class="card-title section-title mb-3"><Icon Name="table" />@Title</h2>

        <div class="filter-row" role="search" aria-label="Filter candidates">
            <div>
                <label class="form-label" for="@Id("min-score")">Min score</label>
                <input id="@Id("min-score")" type="number" class="form-control form-control-sm" min="0" max="1" step="0.05"
                       @bind="Filter.MinScore" @bind:after="FilterChanged" />
            </div>
            <div>
                <label class="form-label" for="@Id("max-aln")">Max alignments</label>
                <input id="@Id("max-aln")" type="number" class="form-control form-control-sm" min="0" max="6"
                       @bind="Filter.MaxAlignments" @bind:after="FilterChanged" />
            </div>
            <div>
                <label class="form-label" for="@Id("min-gc")">GC % from</label>
                <input id="@Id("min-gc")" type="number" class="form-control form-control-sm" min="0" max="100"
                       @bind="Filter.MinGc" @bind:after="FilterChanged" />
            </div>
            <div>
                <label class="form-label" for="@Id("max-gc")">GC % to</label>
                <input id="@Id("max-gc")" type="number" class="form-control form-control-sm" min="0" max="100"
                       @bind="Filter.MaxGc" @bind:after="FilterChanged" />
            </div>
            <div>
                <label class="form-label" for="@Id("contains")">Sequence contains</label>
                <input id="@Id("contains")" type="text" class="form-control form-control-sm filter-wide font-monospace"
                       @bind="Filter.Contains" @bind:event="oninput" @bind:after="FilterChanged" />
            </div>
            <div>
                <label class="form-label" for="@Id("page-size")">Rows</label>
                <select id="@Id("page-size")" class="form-select form-select-sm" @bind="Filter.PageSize" @bind:after="FilterChanged">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>
            @if (Filter.IsActive)
            {
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearFilter">Clear filters</button>
            }
        </div>

        <p class="helper-note" role="status">
            Showing @PageItems.Count of @Filtered.Count candidate@(Filtered.Count == 1 ? "" : "s")@(Filtered.Count != (GRNAs?.Count ?? 0) ? $" (filtered from {GRNAs?.Count})" : "").
            Alignments saturate at 6, so "6+" means six or more.
        </p>

        <div class="grna-table-wrap">
            <table class="table table-hover table-sm grna-table">
                <caption class="visually-hidden">@Title. Use the column header buttons to sort.</caption>
                <thead>
                <tr>
                    <th scope="col">Action</th>
                    @Header("gRNA spacer (5' to 3')", GrnaSortColumn.Sequence, false)
                    @Header("GC score", GrnaSortColumn.GCScore, true)
                    @Header("GC %", GrnaSortColumn.GCContent, true)
                    @Header("Homopolymers", GrnaSortColumn.HomopolymerCount, true)
                    @Header("Alignments", GrnaSortColumn.Alignments, false)
                    @Header("Energy (kcal/mol)", GrnaSortColumn.Energy, true)
                    @Header("Score", GrnaSortColumn.Score, true)
                </tr>
                </thead>
                <tbody>
                @foreach (var g in PageItems)
                {
                    var spacer = g.Sequence;
                    var risk = AlignmentRisk.Describe(g.Allignments);
                    <tr class="@(spacer == SelectedSpacer ? "row-selected" : null)" @key="spacer">
                        <td class="text-nowrap">
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => OnCreateGrna.InvokeAsync(spacer)"
                                    aria-pressed="@(spacer == SelectedSpacer ? "true" : "false")" title="Use this spacer to build the complete gRNA">
                                <Icon Name="@(spacer == SelectedSpacer ? "check" : "plus")" />Use
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary btn-icon-only" @onclick="() => CopyAsync(spacer)"
                                    aria-label="Copy spacer @spacer" title="Copy spacer">
                                <Icon Name="copy" />
                            </button>
                        </td>
                        <td class="seq-cell">
                            <span class="text-muted">5'</span>
                            <SequenceSpan Sequence="@spacer" SeedStart="SeedStart" SeedEnd="SeedEnd"
                                          MutationStart="g.MutationHighlightStart" MutationLength="g.MutationHighlightLength" />
                            <span class="text-muted">3'</span>
                        </td>
                        <td class="num bar-cell bar-gc" style="--w:@Pct(g.GCScore)"><span>@g.GCScore.ToString("0.##")</span></td>
                        <td class="num">@g.GCContent.ToString("F2")</td>
                        <td class="num">@g.HomopolymerCount</td>
                        <td><span class="risk-chip @risk.CssClass"><span class="risk-glyph" aria-hidden="true"></span>@risk.Label</span></td>
                        <td class="num">@(g.RnaFoldResult is null ? "n/a" : g.RnaFoldResult.Energy.ToString("F2"))</td>
                        <td class="num bar-cell" style="--w:@Pct(g.Score)"><span>@g.Score.ToString("P0")</span></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        @if (PageCount > 1)
        {
            <div class="pager">
                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(Filter.Page <= 0)" @onclick="() => Filter.Page--">Previous</button>
                <span>Page @(Filter.Page + 1) of @PageCount</span>
                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(Filter.Page >= PageCount - 1)" @onclick="() => Filter.Page++">Next</button>
            </div>
        }
    </div>
</div>

@code {
    private static int _instance;
    private readonly int _uid = Interlocked.Increment(ref _instance);

    [Parameter] public string Title { get; set; } = "gRNA spacer results";
    [Parameter] public IReadOnlyList<GRNAResult>? GRNAs { get; set; }
    [Parameter] public GrnaSortColumn SortColumn { get; set; }
    [Parameter] public bool SortAscending { get; set; }
    [Parameter] public EventCallback<GrnaSortColumn> OnSortRequested { get; set; }
    [Parameter] public EventCallback<string> OnCreateGrna { get; set; }
    [Parameter] public string? SelectedSpacer { get; set; }
    [Parameter] public GrnaFilter Filter { get; set; } = new();
    [Parameter] public int SeedStart { get; set; }
    [Parameter] public int SeedEnd { get; set; }

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private List<GRNAResult> Filtered => (GRNAs ?? Array.Empty<GRNAResult>()).Where(Filter.Matches).ToList();
    private int PageCount => Math.Max(1, (Filtered.Count + Filter.PageSize - 1) / Filter.PageSize);

    private List<GRNAResult> PageItems
    {
        get
        {
            var page = Math.Clamp(Filter.Page, 0, PageCount - 1);
            return Filtered.Skip(page * Filter.PageSize).Take(Filter.PageSize).ToList();
        }
    }

    private string Id(string name) => $"grna-{_uid}-{name}";
    private static string Pct(double v) => $"{Math.Clamp(v, 0, 1) * 100:0}%".Replace(',', '.');

    private void FilterChanged() => Filter.Page = 0;

    private void ClearFilter()
    {
        var size = Filter.PageSize;
        Filter.MinScore = null;
        Filter.MaxAlignments = null;
        Filter.MinGc = null;
        Filter.MaxGc = null;
        Filter.Contains = null;
        Filter.PageSize = size;
        Filter.Page = 0;
    }

    private async Task CopyAsync(string spacer)
    {
        try { await JS.InvokeAsync<bool>("grnaCopy", spacer); }
        catch (JSDisconnectedException) { }
    }

    private RenderFragment Header(string label, GrnaSortColumn column, bool numeric) => __builder =>
    {
        var active = SortColumn == column;
        var sort = active ? (SortAscending ? "ascending" : "descending") : "none";
        var icon = active ? (SortAscending ? "sort-up" : "sort-down") : "sort";
        <th scope="col" aria-sort="@sort" class="@(numeric ? "num" : null)">
            <button type="button" class="sort-btn" @onclick="() => OnSortRequested.InvokeAsync(column)">
                @label<Icon Name="@icon" />
            </button>
        </th>
    };
}
