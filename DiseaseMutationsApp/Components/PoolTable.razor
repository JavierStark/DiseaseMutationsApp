@using DiseaseMutationsApp.Services

<div class="grna-table-wrap pool-table-scroll">
    <table class="table table-hover table-sm mb-0 align-middle grna-table"><caption class="visually-hidden">Mixtures to prepare</caption>
        <thead>
            <tr>
                <th scope="col" class="pool-col-id">Tube ID</th>
                <th scope="col" class="pool-col-name">Mixture name</th>
                <th scope="col">Guides in tandem</th>
                <th scope="col" class="pool-col-well">Final well on plate</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pool in Pools)
            {
                var current = pool;
                <tr class="pool-row @(current.Id == SelectedPoolId ? "pool-row-selected" : null)"
                    @onclick="() => OnSelectPool.InvokeAsync(current)">
                    <td class="metric-variant">
                        <button type="button" class="sort-btn" aria-pressed="@(current.Id == SelectedPoolId ? "true" : "false")"
                                aria-label="Select tube @current.Id" @onclick="() => OnSelectPool.InvokeAsync(current)" @onclick:stopPropagation="true">@current.Id</button>
                    </td>
                    <td class="metric-plain">@current.Name</td>
                    <td>
                        @if (current.IsEmpty)
                        {
                            <span class="pool-empty-note">Empty &mdash; do not prepare</span>
                        }
                        else
                        {
                            <span class="pool-guide-list">@string.Join(", ", current.GuideLabels)</span>
                        }
                    </td>
                    <td class="metric-reference">@current.WellLabel</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired] public List<PoolWell> Pools { get; set; } = new();

    [Parameter] public int? SelectedPoolId { get; set; }

    [Parameter] public EventCallback<PoolWell> OnSelectPool { get; set; }
}
