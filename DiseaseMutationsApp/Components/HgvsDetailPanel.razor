@using BlazorBootstrap
@using DiseaseMutationsApp.Services
@using DiseaseMutationsApp.Pages

<div>
    @if (Data.IsLoading)
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <Spinner Type="SpinnerType.Dots" Color="SpinnerColor.Primary" />
                <p class="mt-4 text-muted" style="font-size: 1.0625rem;">Loading data for @Data.Hgvs...</p>
            </div>
        </div>
    }
    else if (Data.ErrorMessage != null)
    {
        <div class="alert alert-danger" role="alert">
            <strong style="color: var(--text-primary);">⚠️ Error loading data for @Data.Hgvs:</strong><br/>
            <span style="margin-top: 0.5rem; display: block;">@Data.ErrorMessage</span>
        </div>
    }
    else if (Data is { Original: not null, Mutated: not null })
    {
        <div class="row mb-5">
            <div class="col">
                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <h5 class="card-title mb-3" style="color: var(--color-teal-light);">
                            <span class="oi oi-document me-2"></span>Original Sequence
                        </h5>
                        <div class="font-monospace p-3 rounded" style="background: var(--surface); border: 1px solid var(--border-color); word-break: break-all; line-height: 2; letter-spacing: 0.5px;">
                            @((MarkupString)Data.Original)
                        </div>
                    </div>
                </div>
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title mb-3" style="color: var(--color-purple-light);">
                            <span class="oi oi-target me-2"></span>Mutated Sequence
                        </h5>
                        <div class="font-monospace p-3 rounded" style="background: var(--surface); border: 1px solid var(--border-color); word-break: break-all; line-height: 2; letter-spacing: 0.5px;">
                            @((MarkupString)Data.Mutated)
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (Data.GRNAs != null && Data.GRNAs.Any())
        {
            <div class="row mb-5">
                <div class="col">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title mb-3" style="color: var(--color-green-light);">
                                <span class="oi oi-list me-2"></span>gRNA Results
                            </h5>
                            <p class="text-muted small mb-3" style="font-size: 0.875rem;">
                                <span class="oi oi-info" style="font-size: 0.75rem;"></span> 
                                Click any column header to sort. Tables with more than 5 rows are scrollable.
                            </p>
                            <div class="table-responsive" style="@((Data.GRNAs.Count > 5) ? "max-height: 350px; overflow-y: auto; border: 1px solid var(--border-color); border-radius: var(--radius-md);" : null)">
                                <table class="table table-hover table-striped align-middle mb-0">
                                    <thead class="table-light" style="position: sticky; top: 0; z-index: 5;">
                                    <tr>
                                        <th style="width: 90px;">Action</th>
                                        <th style="cursor: pointer; user-select: none;" @onclick="() => OnSort?.Invoke(Data, global::DiseaseMutationsApp.Pages.GrnaSortColumn.Sequence)">
                                            gRNA Spacer
                                            <span style="font-size: 0.875rem;">@(Data.SortColumn == global::DiseaseMutationsApp.Pages.GrnaSortColumn.Sequence ? (Data.SortAscending ? " ▲" : " ▼") : " ⇅")</span>
                                        </th>
                                        <th style="cursor: pointer; user-select: none;" @onclick="() => OnSort?.Invoke(Data, global::DiseaseMutationsApp.Pages.GrnaSortColumn.GCScore)">
                                            GC Score
                                            <span style="font-size: 0.875rem;">@(Data.SortColumn == global::DiseaseMutationsApp.Pages.GrnaSortColumn.GCScore ? (Data.SortAscending ? " ▲" : " ▼") : " ⇅")</span>
                                        </th>
                                        <th style="cursor: pointer; user-select: none;" @onclick="() => OnSort?.Invoke(Data, global::DiseaseMutationsApp.Pages.GrnaSortColumn.HomopolymerCount)">
                                            Homopolymer
                                            <span style="font-size: 0.875rem;">@(Data.SortColumn == global::DiseaseMutationsApp.Pages.GrnaSortColumn.HomopolymerCount ? (Data.SortAscending ? " ▲" : " ▼") : " ⇅")</span>
                                        </th>
                                        <th style="cursor: pointer; user-select: none;" @onclick="() => OnSort?.Invoke(Data, global::DiseaseMutationsApp.Pages.GrnaSortColumn.SeedRegion)">
                                            Seed Region
                                            <span style="font-size: 0.875rem;">@(Data.SortColumn == global::DiseaseMutationsApp.Pages.GrnaSortColumn.SeedRegion ? (Data.SortAscending ? " ▲" : " ▼") : " ⇅")</span>
                                        </th>
                                        <th style="cursor: pointer; user-select: none;" @onclick="() => OnSort?.Invoke(Data, global::DiseaseMutationsApp.Pages.GrnaSortColumn.Alignments)">
                                            Alignments
                                            <span style="font-size: 0.875rem;">@(Data.SortColumn == global::DiseaseMutationsApp.Pages.GrnaSortColumn.Alignments ? (Data.SortAscending ? " ▲" : " ▼") : " ⇅")</span>
                                        </th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var gRNA in GetSorted?.Invoke(Data) ?? Enumerable.Empty<GRNAResult>())
                                    {
                                        <tr>
                                            <td>
                                                <button class="btn btn-sm btn-secondary" @onclick="() => OnCreateGrna?.Invoke(gRNA.Sequence, Data)" title="Create gRNA" style="font-size: 1.125rem;">
                                                    🔨
                                                </button>
                                            </td>
                                            <td class="font-monospace" style="font-size: 0.875rem; letter-spacing: 0.5px;">@gRNA.Sequence</td>
                                            <td><span style="color: var(--color-teal-light); font-weight: 500;">@gRNA.GCScore</span></td>
                                            <td>@gRNA.HomopolymerCount</td>
                                            <td class="font-monospace" style="font-size: 0.875rem;">@gRNA.SeedRegion</td>
                                            <td><span style="color: var(--color-purple-light); font-weight: 500;">@gRNA.Allignments</span></td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col">
                <div class="card shadow-sm" style="border-color: var(--color-purple); border-width: 1px;">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h5 class="card-title mb-0" style="color: var(--color-purple-light);">
                                <span class="oi oi-beaker me-2"></span>Complete gRNA
                            </h5>
                            @if (Data.SelectedSpacer != null)
                            {
                                <div class="d-flex gap-2">
                                    <button class="btn btn-sm btn-success" @onclick="() => OnCopyComplete?.Invoke(Data)" title="Copy complete gRNA">
                                        @if (Data.CopiedToClipboard)
                                        {
                                            <span class="oi oi-check me-1"></span>
                                            <span>Copied!</span>
                                        }
                                        else
                                        {
                                            <span class="oi oi-clipboard me-1"></span>
                                            <span>Copy</span>
                                        }
                                    </button>
                                    <button class="btn btn-sm btn-primary" @onclick="() => OnGetRnaFold?.Invoke(Data)" disabled="@Data.IsLoadingRnaFold" title="Get RNA secondary structure">
                                        @if (Data.IsLoadingRnaFold)
                                        {
                                            <span>⏳ Loading...</span>
                                        }
                                        else
                                        {
                                            <span>🧬 Get Structure</span>
                                        }
                                    </button>
                                </div>
                            }
                        </div>
                        <div class="font-monospace p-3 rounded" style="background: var(--surface); border: 1px solid var(--border-color); word-break: break-all; line-height: 2.2; font-size: 1.125rem; letter-spacing: 1px;">
                            <span style="color: var(--color-red-light); font-weight: 600;">GATTTAGACTACCCCAAAAACGAAGGGGACTAAAAC</span>@if (Data.SelectedSpacer != null)
                            {<span style="color: var(--color-purple-light); font-weight: 600;">@Data.SelectedSpacer</span>}
                        </div>
                        @if (Data.SelectedSpacer == null)
                        {
                            <p class="text-muted mt-3 mb-0 d-flex align-items-center" style="font-size: 0.9375rem;">
                                <span class="oi oi-info me-2" style="font-size: 0.875rem;"></span>
                                <span>Click the 🔨 button on a gRNA spacer to add it here</span>
                            </p>
                        }
                        
                        @if (Data.RnaFoldResult != null)
                        {
                            <div class="mt-4 pt-4" style="border-top: 2px solid var(--divider-color);">
                                <h6 class="mb-4" style="color: var(--color-teal-light); font-size: 1.125rem;">
                                    <span class="oi oi-graph me-2"></span>RNA Secondary Structure
                                </h6>
                                
                                @if (!string.IsNullOrEmpty(Data.FornaUrl))
                                {
                                    <div class="mb-4" style="border: 1px solid var(--border-color); border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-md);">
                                        <iframe src=@Data.FornaUrl
                                                style="width: 100%; height: 600px; border: none; display: block;"
                                                title="RNA Secondary Structure Visualization">
                                        </iframe>
                                    </div>
                                }
                                
                                <div class="mb-4">
                                    <strong style="color: var(--text-primary); font-size: 0.9375rem;">Dot-Bracket Notation:</strong>
                                    <div class="font-monospace p-3 rounded mt-2" style="background: var(--surface); border: 1px solid var(--border-color); word-break: break-all; line-height: 2; font-size: 0.9375rem; letter-spacing: 0.5px;">
                                        @Data.RnaFoldResult.Structure
                                    </div>
                                </div>
                                
                                <div style="padding: 1rem; background: linear-gradient(135deg, rgba(6, 182, 212, 0.1) 0%, rgba(168, 85, 247, 0.1) 100%); border-radius: var(--radius-md); border: 1px solid var(--border-color);">
                                    <strong style="color: var(--text-primary);">Minimum Free Energy:</strong> 
                                    <span style="color: var(--color-green-light); font-size: 1.125rem; font-weight: 600; margin-left: 0.5rem;">
                                        @Data.RnaFoldResult.Energy.ToString("F2") kcal/mol
                                    </span>
                                </div>
                            </div>
                        }
                        
                        @if (Data.RnaFoldError != null)
                        {
                            <div class="alert alert-danger mt-4 mb-0" role="alert">
                                <strong style="color: var(--text-primary);">⚠️ Error getting RNA structure:</strong><br/>
                                <span style="margin-top: 0.5rem; display: block;">@Data.RnaFoldError</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public HgvsData Data { get; set; } = null!;
    [Parameter] public Action<HgvsData, GrnaSortColumn>? OnSort { get; set; }
    [Parameter] public Func<HgvsData, IEnumerable<GRNAResult>>? GetSorted { get; set; }
    [Parameter] public Action<string, HgvsData>? OnCreateGrna { get; set; }
    [Parameter] public Func<HgvsData, Task>? OnCopyComplete { get; set; }
    [Parameter] public Func<HgvsData, Task>? OnGetRnaFold { get; set; }
}
