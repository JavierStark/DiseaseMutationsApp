@using BlazorBootstrap
@using DiseaseMutationsApp.Services
@using DiseaseMutationsApp.Pages

<div>
    @if (Data.IsLoading)
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <Spinner Type="SpinnerType.Dots" Color="SpinnerColor.Primary" />
                <p class="mt-3 text-muted">Loading data for @Data.Hgvs...</p>
            </div>
        </div>
    }
    else if (Data.ErrorMessage != null)
    {
        <div class="alert alert-danger" role="alert">
            <strong>Error loading data for @Data.Hgvs:</strong><br/>
            @Data.ErrorMessage
        </div>
    }
    else if (Data is { Original: not null, Mutated: not null })
    {
        <div class="row mb-4">
            <div class="col">
                <div class="card shadow-sm mb-3">
                    <div class="card-body">
                        <h5 class="card-title mb-3">Original Sequence</h5>
                        <p class="font-monospace bg-light p-3 rounded" style="word-break: break-all; line-height: 1.8;">@((MarkupString)Data.Original)</p>
                    </div>
                </div>
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title mb-3">Mutated Sequence</h5>
                        <p class="font-monospace bg-light p-3 rounded" style="word-break: break-all; line-height: 1.8;">@((MarkupString)Data.Mutated)</p>
                    </div>
                </div>
            </div>
        </div>

        @if (Data.GRNAs != null && Data.GRNAs.Any())
        {
            <div class="row mb-4">
                <div class="col">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title mb-3">gRNA Results</h5>
                            <p class="text-muted small mb-2">Tip: Click any column header to sort ascending/descending. If more than 5 rows are present, the table becomes scrollable.</p>
                            <div class="table-responsive" style="@((Data.GRNAs.Count > 5) ? "max-height: 300px; overflow-y: auto;" : null)">
                                <table class="table table-hover table-striped align-middle">
                                    <thead class="table-light">
                                    <tr>
                                        <th style="width: 80px;">Action</th>
                                        <th style="cursor: pointer;" @onclick="() => OnSort?.Invoke(Data, global::DiseaseMutationsApp.Pages.GrnaSortColumn.Sequence)">
                                            gRNA Spacer
                                            <span>@(Data.SortColumn == global::DiseaseMutationsApp.Pages.GrnaSortColumn.Sequence ? (Data.SortAscending ? " ▲" : " ▼") : string.Empty)</span>
                                        </th>
                                        <th style="cursor: pointer;" @onclick="() => OnSort?.Invoke(Data, global::DiseaseMutationsApp.Pages.GrnaSortColumn.GCScore)">
                                            GC Score
                                            <span>@(Data.SortColumn == global::DiseaseMutationsApp.Pages.GrnaSortColumn.GCScore ? (Data.SortAscending ? " ▲" : " ▼") : string.Empty)</span>
                                        </th>
                                        <th style="cursor: pointer;" @onclick="() => OnSort?.Invoke(Data, global::DiseaseMutationsApp.Pages.GrnaSortColumn.HomopolymerCount)">
                                            Homopolymer Count
                                            <span>@(Data.SortColumn == global::DiseaseMutationsApp.Pages.GrnaSortColumn.HomopolymerCount ? (Data.SortAscending ? " ▲" : " ▼") : string.Empty)</span>
                                        </th>
                                        <th style="cursor: pointer;" @onclick="() => OnSort?.Invoke(Data, global::DiseaseMutationsApp.Pages.GrnaSortColumn.SeedRegion)">
                                            Seed Region
                                            <span>@(Data.SortColumn == global::DiseaseMutationsApp.Pages.GrnaSortColumn.SeedRegion ? (Data.SortAscending ? " ▲" : " ▼") : string.Empty)</span>
                                        </th>
                                        <th style="cursor: pointer;" @onclick="() => OnSort?.Invoke(Data, global::DiseaseMutationsApp.Pages.GrnaSortColumn.Alignments)">
                                            Alignments
                                            <span>@(Data.SortColumn == global::DiseaseMutationsApp.Pages.GrnaSortColumn.Alignments ? (Data.SortAscending ? " ▲" : " ▼") : string.Empty)</span>
                                        </th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var gRNA in GetSorted?.Invoke(Data) ?? Enumerable.Empty<GRNAResult>())
                                    {
                                        <tr>
                                            <td>
                                                <button class="btn btn-sm btn-secondary" @onclick="() => OnCreateGrna?.Invoke(gRNA.Sequence, Data)" title="Create gRNA">
                                                    🔨
                                                </button>
                                            </td>
                                            <td class="font-monospace">@gRNA.Sequence</td>
                                            <td>@gRNA.GCScore</td>
                                            <td>@gRNA.HomopolymerCount</td>
                                            <td>@gRNA.SeedRegion</td>
                                            <td>@gRNA.Allignments</td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="card-title mb-0">Complete gRNA</h5>
                            @if (Data.SelectedSpacer != null)
                            {
                                <div>
                                    <button class="btn btn-sm btn-success me-2" @onclick="() => OnCopyComplete?.Invoke(Data)" title="Copy complete gRNA">
                                        @if (Data.CopiedToClipboard)
                                        {
                                            <span>✓ Copied!</span>
                                        }
                                        else
                                        {
                                            <span>📋 Copy</span>
                                        }
                                    </button>
                                    <button class="btn btn-sm btn-primary" @onclick="() => OnGetRnaFold?.Invoke(Data)" disabled="@Data.IsLoadingRnaFold" title="Get RNA secondary structure">
                                        @if (Data.IsLoadingRnaFold)
                                        {
                                            <span>⏳ Loading...</span>
                                        }
                                        else
                                        {
                                            <span>🧬 Get Structure</span>
                                        }
                                    </button>
                                </div>
                            }
                        </div>
                        <p class="font-monospace fs-5 mb-0" style="word-break: break-all; line-height: 1.8;">
                            <span style="color: #d15b5b; font-weight: 500;">GATTTAGACTACCCCAAAAACGAAGGGGACTAAAAC</span>@if (Data.SelectedSpacer != null)
                            {<span style="color: #4b4bba; font-weight: 500;">@Data.SelectedSpacer</span>}
                        </p>
                        @if (Data.SelectedSpacer == null)
                        {
                            <p class="text-muted mt-2 mb-0"><small>Click the 🔨 button on a gRNA spacer to add it here</small></p>
                        }
                        
                        @if (Data.RnaFoldResult != null)
                        {
                            <div class="mt-4 pt-3 border-top">
                                <h6 class="mb-3">RNA Secondary Structure</h6>
                                
                                @if (!string.IsNullOrEmpty(Data.FornaUrl))
                                {
                                    
                                    <iframe src=@Data.FornaUrl
                                            style="width: 100%; height: 600px; border: 1px solid #dee2e6; border-radius: 0.375rem;"
                                            title="RNA Secondary Structure Visualization">
                                    </iframe>
                                }
                                
                                <div class="mb-2">
                                    <strong>Dot-Bracket Notation:</strong>
                                    <p class="font-monospace bg-light p-3 rounded mb-0 mt-2" style="word-break: break-all; line-height: 1.8; font-size: 0.9rem;">
                                        @Data.RnaFoldResult.Structure
                                    </p>
                                </div>
                                
                                <p class="mb-0 mt-2"><strong>Minimum Free Energy:</strong> @Data.RnaFoldResult.Energy.ToString("F2") kcal/mol</p>
                            </div>
                        }
                        
                        @if (Data.RnaFoldError != null)
                        {
                            <div class="alert alert-danger mt-3 mb-0" role="alert">
                                <strong>Error getting RNA structure:</strong><br/>
                                @Data.RnaFoldError
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public HgvsData Data { get; set; } = null!;
    [Parameter] public Action<HgvsData, GrnaSortColumn>? OnSort { get; set; }
    [Parameter] public Func<HgvsData, IEnumerable<GRNAResult>>? GetSorted { get; set; }
    [Parameter] public Action<string, HgvsData>? OnCreateGrna { get; set; }
    [Parameter] public Func<HgvsData, Task>? OnCopyComplete { get; set; }
    [Parameter] public Func<HgvsData, Task>? OnGetRnaFold { get; set; }
}
