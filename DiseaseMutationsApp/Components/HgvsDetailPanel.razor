﻿@using BlazorBootstrap
@using DiseaseMutationsApp.Services
@using DiseaseMutationsApp.Pages

<div>
    @if (Data.IsLoading)
    {
        <div class="text-center py-5">
            <Spinner Type="SpinnerType.Dots" Color="SpinnerColor.Primary" />
            <p class="mt-4 text-muted loading-description">Loading data for <span title="@Data.Hgvs">@Data.Hgvs</span>...</p>
        </div>
    }
    else if (Data.ErrorMessage != null)
    {
        <div class="alert alert-danger" role="alert">
            <strong class="alert-heading">⚠️ Error loading data for <span title="@Data.Hgvs">@Data.Hgvs</span>:</strong><br/>
            <span class="alert-detail">@Data.ErrorMessage</span>
        </div>
    }
    else if (Data is { Original: not null, Mutated: not null })
    {
        <div class="row mb-5">
            <div class="col">
                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <h5 class="card-title mb-3 sequence-title-original">
                            <span class="oi oi-document me-2"></span>Original Sequence
                        </h5>
                        <div class="font-monospace p-3 rounded sequence-block">
                            @((MarkupString)Data.Original)
                        </div>
                    </div>
                </div>
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title mb-3 sequence-title-mutated">
                            <span class="oi oi-target me-2"></span>Mutated Sequence
                        </h5>
                        <div class="font-monospace p-3 rounded sequence-block">
                            @((MarkupString)Data.Mutated)
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (Data.GRNAs != null && Data.GRNAs.Any())
        {
            <div class="row mb-5">
                <div class="col">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title mb-3 section-title-secondary">
                                <span class="oi oi-list me-2"></span>gRNA Spacer Results
                            </h5>
                            <p class="text-muted small mb-3 helper-hint">
                                <span class="oi oi-info helper-hint-icon"></span> 
                                Click any column header to sort. Tables with more than 5 rows are scrollable.
                            </p>
                            <div class="table-responsive grna-table-wrapper @(Data.GRNAs.Count > 5 ? "grna-table-wrapper-scrollable" : string.Empty)">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light grna-table-head">
                                    <tr>
                                        <th class="grna-action-col">Action</th>
                                        <th class="sortable-col" @onclick="() => OnSort?.Invoke(Data, GrnaSortColumn.Sequence)">
                                            gRNA Spacer
                                            <span class="sort-icon">@(Data.SortColumn == GrnaSortColumn.Sequence ? (Data.SortAscending ? " ▲" : " ▼") : " ⇅")</span>
                                        </th>
                                        <th class="sortable-col" @onclick="() => OnSort?.Invoke(Data, GrnaSortColumn.GCScore)">
                                            GC Score
                                            <span class="sort-icon">@(Data.SortColumn == GrnaSortColumn.GCScore ? (Data.SortAscending ? " ▲" : " ▼") : " ⇅")</span>
                                        </th>
                                        <th class="sortable-col" @onclick="() => OnSort?.Invoke(Data, GrnaSortColumn.HomopolymerCount)">
                                            Homopolymer
                                            <span class="sort-icon">@(Data.SortColumn == GrnaSortColumn.HomopolymerCount ? (Data.SortAscending ? " ▲" : " ▼") : " ⇅")</span>
                                        </th>
                                        <th class="sortable-col" @onclick="() => OnSort?.Invoke(Data, GrnaSortColumn.SeedRegion)">
                                            Seed Region
                                            <span class="sort-icon">@(Data.SortColumn == GrnaSortColumn.SeedRegion ? (Data.SortAscending ? " ▲" : " ▼") : " ⇅")</span>
                                        </th>
                                        <th class="sortable-col" @onclick="() => OnSort?.Invoke(Data, GrnaSortColumn.Alignments)">
                                            Alignments
                                            <span class="sort-icon">@(Data.SortColumn == GrnaSortColumn.Alignments ? (Data.SortAscending ? " ▲" : " ▼") : " ⇅")</span>
                                        </th>
                                        <th class="sortable-col" @onclick="() => OnSort?.Invoke(Data, GrnaSortColumn.Energy)">
                                            Energy
                                            <span class="sort-icon">@(Data.SortColumn == GrnaSortColumn.Energy ? (Data.SortAscending ? " ▲" : " ▼") : " ⇅")</span>
                                        </th>
                                        <th class="sortable-col" @onclick="() => OnSort?.Invoke(Data, GrnaSortColumn.Score)">
                                            Score
                                            <span class="sort-icon">@(Data.SortColumn == GrnaSortColumn.Score ? (Data.SortAscending ? " ▲" : " ▼") : " ⇅")</span>
                                        </th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var gRNA in GetSorted?.Invoke(Data) ?? [])
                                    {
                                        <tr>
                                            <td>
                                                <button class="btn btn-sm btn-secondary action-btn-icon" @onclick="() => OnCreateGrna?.Invoke(gRNA.Sequence, Data)" title="Create gRNA">
                                                    🔨
                                                </button>
                                            </td>
                                            <td class="font-monospace grna-seq-cell">@gRNA.Sequence</td>
                                            <td><span class="metric-default">@gRNA.GCScore</span></td>
                                            <td><span class="metric-default">@gRNA.HomopolymerCount</span></td>
                                            <td class="font-monospace grna-seed-cell">@gRNA.SeedRegion</td>
                                            <td><span class="metric-accent-secondary">@gRNA.Allignments</span></td>
                                            <td><span class="metric-accent-success">@gRNA.RnaFoldResult.Energy.ToString("F2")</span></td>
                                            <td><span class="metric-accent-primary">@gRNA.Score.ToString("P1")</span></td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col">
                <div class="card shadow-sm complete-grna-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h5 class="card-title mb-0 complete-grna-title">
                                <span class="oi oi-beaker me-2"></span>Complete gRNA
                            </h5>
                            @if (Data.SelectedSpacer != null)
                            {
                                <div class="d-flex gap-2">
                                    <button class="btn btn-sm btn-success" @onclick="() => OnCopyComplete?.Invoke(Data)" title="Copy complete gRNA">
                                        @if (Data.CopiedToClipboard)
                                        {
                                            <span class="oi oi-check me-1"></span>
                                            <span>Copied!</span>
                                        }
                                        else
                                        {
                                            <span class="oi oi-clipboard me-1"></span>
                                            <span>Copy</span>
                                        }
                                    </button>
                                    <button class="btn btn-sm btn-primary" @onclick="() => OnGetRnaFold?.Invoke(Data)" disabled="@Data.IsLoadingRnaFold" title="Get RNA secondary structure">
                                        @if (Data.IsLoadingRnaFold)
                                        {
                                            <span>⏳ Loading...</span>
                                        }
                                        else
                                        {
                                            <span>🧬 Get Structure</span>
                                        }
                                    </button>
                                </div>
                            }
                        </div>
                        <div class="font-monospace p-3 rounded complete-grna-sequence">
                            <span class="scaffold-seq">GAUUUAGACUACCCCAAAAACGAAGGGGACUAAAAC</span>
                            @if (Data.SelectedSpacer != null)
                            {<span class="spacer-seq">@Data.SelectedSpacer</span>}
                        </div>
                        @if (Data.SelectedSpacer == null)
                        {
                            <p class="text-muted mt-3 mb-0 d-flex align-items-center helper-note">
                                <span class="oi oi-info me-2 helper-note-icon"></span>
                                <span>Click the 🔨 button on a gRNA spacer to add it here</span>
                            </p>
                        }
                                               
                        @if (Data.RnaFoldResult != null)
                        {
                            <div class="mt-4 pt-4 structure-section">
                                <h6 class="mb-4 structure-title">
                                    <span class="oi oi-graph me-2"></span>RNA Secondary Structure
                                </h6>
                                
                                @if (!string.IsNullOrEmpty(Data.FornaUrl))
                                {
                                    <div class="mb-4 forna-frame">
                                        <iframe src=@Data.FornaUrl
                                                title="RNA Secondary Structure Visualization">
                                        </iframe>
                                    </div>
                                }
                                
                                <div class="mb-4">
                                    <strong class="structure-label">Dot-Bracket Notation:</strong>
                                    <div class="font-monospace p-3 rounded mt-2 structure-block">
                                        @Data.RnaFoldResult.Structure
                                    </div>
                                </div>
                                
                                <div class="energy-summary">
                                    <strong class="alert-heading">Minimum Free Energy:</strong>
                                    <span class="energy-value">
                                        @Data.RnaFoldResult.Energy.ToString("F2") kcal/mol
                                    </span>
                                </div>
                            </div>
                        }
                        
                        @if (Data.RnaFoldError != null)
                        {
                            <div class="alert alert-danger mt-4 mb-0" role="alert">
                                <strong class="alert-heading">⚠️ Error getting RNA structure:</strong><br/>
                                <span class="alert-detail">@Data.RnaFoldError</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public HgvsData Data { get; set; } = null!;
    [Parameter] public Action<HgvsData, GrnaSortColumn>? OnSort { get; set; }
    [Parameter] public Func<HgvsData, IEnumerable<GRNAResult>>? GetSorted { get; set; }
    [Parameter] public Action<string, HgvsData>? OnCreateGrna { get; set; }
    [Parameter] public Func<HgvsData, Task>? OnCopyComplete { get; set; }
    [Parameter] public Func<HgvsData, Task>? OnGetRnaFold { get; set; }
}
