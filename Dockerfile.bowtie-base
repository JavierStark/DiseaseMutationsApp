FROM mcr.microsoft.com/dotnet/aspnet:9.0-bookworm-slim
WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl unzip ca-certificates && \
    curl -L https://github.com/peak/s5cmd/releases/download/v2.2.2/s5cmd_2.2.2_Linux-64bit.tar.gz | tar -xz && \
    ./s5cmd --no-sign-request cp s3://genome-idx/bt/GRCh38_noalt_as.zip /tmp/archive.zip && \
    mkdir -p /app/bowtie/indexes && \
    unzip /tmp/archive.zip -d /app/bowtie/indexes && \
    rm /tmp/archive.zip ./s5cmd && \
    apt-get purge -y curl unzip ca-certificates && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*