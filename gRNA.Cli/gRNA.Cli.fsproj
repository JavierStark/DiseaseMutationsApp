<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <AssemblyName>gRNA.Cli</AssemblyName>
        <RootNamespace>gRNA.Cli</RootNamespace>
        <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
        <!-- Install: dotnet tool install, global, from a local nupkg folder; then run grna -->
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>grna</ToolCommandName>
        <PackageId>gRNA.Cli</PackageId>
        <Version>1.0.0</Version>
        <Description>Headless gRNA design pipeline: resolve rsIDs, design ranked Cas13 spacers, fold, and plan guide pooling.</Description>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Program.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FSharp.Core" />
        <ProjectReference Include="..\gRNA\gRNA.fsproj" />
    </ItemGroup>

</Project>
