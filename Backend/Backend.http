#@Backend_HostAddress = http://localhost:5150
@Backend_HostAddress = http://localhost:5000
@timeout = 120000


### Get best gRNA with window size and sequence
GET {{Backend_HostAddress}}/getbestrna?window=15&sequence=ATGCGATCGATCGATCGATCGATCG
Accept: application/json

###

### Get all alignments using Bowtie
GET {{Backend_HostAddress}}/getallignments?sequence=ACTGACTGACTGACTG&mismatches=2&threads=4
Accept: application/json

###

### Get best gRNA from HGVS notation
GET {{Backend_HostAddress}}/getbestgrnafromhgvs?hgvs=NM_000546.6:c.215C>G&window=15
Accept: application/json

###
