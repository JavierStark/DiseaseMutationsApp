<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <PackageId>gRNA</PackageId>
        <Version>1.0.0</Version>
        <Authors>Javier Torralbo Cortes</Authors>
        <Description>CRISPR-Cas13 gRNA design pipeline: HGVS/rsID to ranked spacers, off-target counting and guide pooling.</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Pooling.fs" />
        <Compile Include="Environment.fs" />
        <Compile Include="Parsing.fs" />
        <Compile Include="HGVS.fs" />
        <Compile Include="RNAFoldWrapper.fs" />
        <Compile Include="Sequence.fs" />
        <Compile Include="SequenceRepository.fs" />
        <Compile Include="BowtieWrapper.fs" />
        <Compile Include="BowtieService.fs" />
        <Compile Include="Diagnostics.fs" />
        <Compile Include="SpacerFinder.fs" />
        <Compile Include="Main.fs" />
    </ItemGroup>

    <ItemGroup>
        <None Include="LibraryTesting.fsx" />
        <None Include="LevenshteinDistance.fs" />
        <Compile Include="SNP.fs" />
        <None Include="snp_sample.json" />
        <None Include="Omim.fs" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Update="FSharp.Core" Version="10.0.101" />
    </ItemGroup>

</Project>
