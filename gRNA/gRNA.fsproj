<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="HGVS.fs" />
        <Compile Include="RNAFoldWrapper.fs" />
        <Compile Include="Sequence.fs" />
        <Compile Include="SequenceRepository.fs" />
        <Compile Include="BowtieWrapper.fs" />
        <Compile Include="SpacerFinder.fs" />
        <Compile Include="Main.fs" />
    </ItemGroup>

    <ItemGroup>
        <None Include="LibraryTesting.fsx" />
        <Compile Include="LevenshteinDistance.fs" />
        <Compile Include="SNP.fs" />
        <Content Include="snp_sample.json" />
        <Compile Include="Omim.fs" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="FSharp.Data" Version="6.6.0" />
      <PackageReference Include="FSharp.Data.JsonProvider" Version="0.5.0" />
      <PackageReference Update="FSharp.Core" Version="10.0.101" />
    </ItemGroup>

</Project>
